node_modules/
dist/
.vite/
*.tsbuildinfo

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# local env — this app has no secrets, but keep the habit
.env
.env.*
!.env.example

*.log
npm-debug.log*

# tool exhaust from other agents
.openai/
.gstack/
.codex-dev.*

release/
pipeline/.cache/

# Private GIS layers — supplied through a private channel, licences unverified,
# HERMES local units are explicitly non-redistributable. Local use only.
# Served by a dev-only Vite route so they never reach dist/ (they used to).
sources/local/

# Private DHM daily discharge records — supplied privately, not redistributable.
# DHM sells hydrological data through a procurement process and publishes no
# open licence, so neither the dailies nor the statistics derived from them may
# ship. src/data/dhm-records.json used to travel and no longer does: the
# identity-only twin src/data/dhm-records.public.json is tracked in its place,
# pipeline/restore-dhm-records.mjs copies that into position when the licensed
# index is absent, and pipeline/build-dhm-records.mjs rebuilds the full one from
# the yearbooks. See LICENSES.md, blocker 1.
sources/dhm/
src/data/dhm-records.json

# MERIT Hydro tiles — licensed to one user under CC-BY-NC 4.0 via a registered
# download, and the terms forbid redistributing the originals. The derived
# per-vertex catchment areas travel; the GeoTIFFs do not.
sources/merit-hydro/

# GloFAS reanalysis subset for Nepal. Large, ECMWF's to distribute, and
# reproducible from pipeline/fetch-glofas-nepal.py.
sources/glofas/

# GEDTM30 is CC-BY-4.0 and redistributable; this is a ~1 GB derived raster kept
# out of the repository for size, not for licence. pipeline/build-gedtm-nepal.py
# rebuilds it from the public COG.
sources/gedtm/

# ESA WorldCover is CC-BY-4.0 and redistributable; this is a ~600 MB derived
# raster kept out of the repository for size, not for licence.
# pipeline/build-worldcover-nepal.py rebuilds it from the public COGs.
sources/worldcover/

# Nepal DMG province geological maps, rendered to tiles. Free downloads from the
# publishing department, but DMG sells printed sheets: derived tiles stay local.
# pipeline/build-dmg-geology.py rebuilds them.
sources/geology/

# Private and supplied layers. CLAUDE.md has always CLAIMED these two were
# ignored and they were not — 200 MB of supplied data sat one `git add -A`
# away from the history. Found by `git check-ignore` while adding the RDS
# rules below; the lesson is that a claim in a document is not a rule on disk.
sources/gem-pga/
sources/icimod-pdgl/

# ICIMOD RDS downloads. All CC-BY-4.0 and re-downloadable from rds.icimod.org
# with one sign-in, so these are gitignored for SIZE, not licence — FRTC's
# forest-type raster alone unpacks to 4.2 GB.
sources/icimod-rds/
sources/icimod-geology/

# Rendered desk studies. pipeline/render-report.mjs makes one for any site;
# they are 2.5 MB of a specific place and belong to a session, not the repo.
report.pdf
*.report.pdf

# Build and scratch artefacts, not source.
pipeline/__pycache__/
tmp/
checks/.osm-snapped.json

# Dated safety copies of accumulated measurement output. The live file is
# tracked because CLAUDE.md's accuracy table rests on it; its backups are a
# local undo, not history.
src/data/*.backup-*.json

# RGI 7.0 region file — 23 MB zip, 65 MB unpacked. CC-BY-4.0 and public:
# rebuild with `npm run build:glaciers` after unzipping it here.
sources/rgi/

# GSW pondage reference tiles: rebuild with one command, 130 MB
sources/gsw/

# Scratch from the US-sources exploration — raw probe responses dumped to the
# repo root while checking what a non-Nepal build could read (CUAHSI WaterML,
# the NID error body, NWM zarr chunks). ~20 MB of nothing reproducible.
# docs/US-SOURCES.md is the keepable half; these are the exhaust.
/a.json
/b.json
/c.json
/f.json
/g.json
/p.json
/r.json
/s.json
/ss.json
/ut.json
/zm.json
/dm.json
/dv.json
/nid.json
/pos.json
/basin.json
/gage_id.bin
/order.bin
/chunk.bin

# Agent routing bookkeeping. About how work got delegated in this workspace,
# not about the app.
.claude/agent-memory/
.claude/autoroute/

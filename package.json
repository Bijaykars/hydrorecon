{
  "name": "ghatta",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check": "node --experimental-strip-types --no-warnings checks/hydro.check.ts && node --experimental-strip-types --no-warnings checks/plants.check.ts && node --experimental-strip-types --no-warnings checks/hydrogenerate.check.ts && node --experimental-strip-types --no-warnings checks/export.check.ts && node --experimental-strip-types --no-warnings checks/gauges.check.ts && node --experimental-strip-types --no-warnings checks/waterway.check.ts && node --experimental-strip-types --no-warnings checks/hydest.check.ts && node --experimental-strip-types --no-warnings checks/grid.check.ts && node --experimental-strip-types --no-warnings checks/measured.check.ts",
    "desktop": "npm run build && electron desktop/main.cjs",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "build:dhm": "node pipeline/build-dhm-stations.mjs",
    "build:rivers": "node pipeline/build-hydrorivers.mjs",
    "probe:dem": "node checks/dem-vs-survey.probe.mjs",
    "build:hypso": "node pipeline/build-hypsometry.mjs",
    "build:grid": "node pipeline/build-grid.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "org.ghatta.workbench",
    "productName": "Ghatta",
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "adm-zip": "^0.6.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.62.1",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
